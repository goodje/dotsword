#!/bin/bash

# defaults to the existing global git identity; override with --name/--email
USER_NAME="$(git config --global --includes user.name 2>/dev/null)"
USER_EMAIL="$(git config --global --includes user.email 2>/dev/null)"
GLOBAL=
SETUP_HOOK=1


for i in "$@"; do
case $i in
    -n=*|--name=*)
    USER_NAME="${i#*=}"
    shift # past argument=value
    ;;
    -m=*|--email=*)
    USER_EMAIL="${i#*=}"
    shift # past argument=value
    ;;
    -g|--global)
    GLOBAL="--global"
    shift # past argument=value
    ;;
esac
done

# finish initiation

if [[ -z "${USER_NAME}" || -z "${USER_EMAIL}" ]]; then
    echo "usage: git_repo_start [-g|--global] --name=<name> --email=<email>"
    echo "no git identity found; pass --name and --email"
    exit 1
fi

git config ${GLOBAL} user.name "${USER_NAME}"
git config ${GLOBAL} user.email "${USER_EMAIL}"

if [[ -n "${SETUP_HOOK}" ]]; then
    if [[ -z "${GLOBAL}" ]]; then
        cp ~/.sword/custom/classified.git.hook.prepare-commit-msg .git/hooks/prepare-commit-msg
        chmod u+x .git/hooks/prepare-commit-msg
    fi
fi
