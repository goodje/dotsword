#!/bin/sh
# Block commits that leak secrets or add known-vulnerable dependencies.
# Enabled by install.sh via `git config core.hooksPath githooks`.
set -e
cd "$(git rev-parse --show-toplevel)"

# custom/gitleaks.local.toml (gitignored) extends .gitleaks.toml with personal rules
cfg=.gitleaks.toml
[ -f custom/gitleaks.local.toml ] && cfg=custom/gitleaks.local.toml
gitleaks git --pre-commit --staged -v --redact --no-banner --config "$cfg"

# osv-scanner queries osv.dev; only run when a dependency manifest is staged
if git diff --cached --name-only | grep -qE '(requirements[^/]*\.txt|[^/]*lock[^/]*)$'; then
  osv-scanner scan source -r --no-resolve .
fi
