SWORD_PATH=${HOME}/.sword

SWORD_CUSTOM_PATH=${SWORD_PATH}/custom

# -- PATH
if [[ -d /snap/bin ]]; then
    export PATH=/snap/bin:$PATH
fi

if [[ -d ~/.local/bin ]]; then
    export PATH=~/.local/bin:$PATH
fi

export PATH=~/.sword/bin:$PATH

# -- alias
alias ll="ls -alh"
alias l="ll"
alias tmux="TERM=screen-256color tmux"
alias s="cd $SWORD_PATH"

alias k='kubectl'
alias kg='kubectl get'
alias kgp='kubectl get pods'
alias kgd='kubectl deployments'
alias kgs='kubectl get services'
alias kgd='kubectl get deployments'
alias kd='kubectl describe'
alias kl='kubectl logs'

# -- rainbow Chrome (macOS, Chrome installed)
if [[ -d "/Applications/Google Chrome.app" ]]; then
    # Rainbow Chrome instances (ROYGBIV -> ports 9223-9229). R,O,Y,G windowed; B,I,V headless.
    alias chromeR='open -na "Google Chrome" --args --remote-debugging-port=9223 --user-data-dir="$HOME/.chrome-profile-9223"'
    alias chromeO='open -na "Google Chrome" --args --remote-debugging-port=9224 --user-data-dir="$HOME/.chrome-profile-9224"'
    alias chromeY='open -na "Google Chrome" --args --remote-debugging-port=9225 --user-data-dir="$HOME/.chrome-profile-9225"'
    alias chromeG='open -na "Google Chrome" --args --remote-debugging-port=9226 --user-data-dir="$HOME/.chrome-profile-9226"'
    alias chromeB='"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless=new --remote-debugging-port=9227 --user-data-dir="$HOME/.chrome-profile-9227" &>/dev/null &'
    alias chromeI='"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless=new --remote-debugging-port=9228 --user-data-dir="$HOME/.chrome-profile-9228" &>/dev/null &'
    alias chromeV='"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --headless=new --remote-debugging-port=9229 --user-data-dir="$HOME/.chrome-profile-9229" &>/dev/null &'
    # Kill a single rainbow Chrome instance (and stop its chrome-devtools daemon, see bin/cdt)
    alias kill-chromeR='cdt R stop; pids=$(lsof -nP -iTCP:9223 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeO='cdt O stop; pids=$(lsof -nP -iTCP:9224 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeY='cdt Y stop; pids=$(lsof -nP -iTCP:9225 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeG='cdt G stop; pids=$(lsof -nP -iTCP:9226 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeB='cdt B stop; pids=$(lsof -nP -iTCP:9227 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeI='cdt I stop; pids=$(lsof -nP -iTCP:9228 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    alias kill-chromeV='cdt V stop; pids=$(lsof -nP -iTCP:9229 -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids'
    # Kill all rainbow Chrome instances (ports 9223-9229)
    alias kill-chromeAll='for c in R O Y G B I V; do cdt $c stop; done; for p in 9223 9224 9225 9226 9227 9228 9229; do pids=$(lsof -nP -iTCP:$p -sTCP:LISTEN -t 2>/dev/null); [ -n "$pids" ] && kill $pids; done'
fi

# -- encoding
# export LC_ALL=en_US.UTF-8
export CLICOLOR=1 #terminal color
export TERM=xterm-256color

# -- zsh
if [[ $SHELL == *"/zsh" ]]; then
    ZSH_CUSTOM=$SWORD_PATH/zsh
    # DISABLE_AUTO_TITLE="true"
fi
# disable zsh substitution/autocomplete with URL and backslashes
DISABLE_MAGIC_FUNCTIONS=true

# powerline, used for enhancing shell, powerline foot is required
# source ~/.local/lib/python2.7/site-packages/powerline/bindings/zsh/powerline.zsh

# custom rc
if [[ -f ${SWORD_PATH}/shell.custom.rc ]]; then
    source ${SWORD_PATH}/shell.custom.rc
fi

if [[ -f $SWORD_CUSTOM_PATH/classified.shell.rc ]]; then
    source $SWORD_CUSTOM_PATH/classified.shell.rc
fi

# set -o vi

# if command nvim exists
if command -v nvim &> /dev/null; then
    alias nv=nvim
    alias nvdiff='nvim -d'
    export EDITOR=nvim
fi
