[core]
    editor = vim
    excludesfile = ~/.sword/git/gitignore

# Identity is kept out of the repo. Put [user] name/email in
# ~/.sword/custom/gitconfig.local (gitignored), or run:
#   git_repo_start -g --name=<name> --email=<email>
[include]
    path = ~/.sword/custom/gitconfig.local

[url "git@github.com:"]
     insteadOf = https://github.com/

[diff]
	tool = vimdiff

[difftool]
    prompt = false

[mergetool]
    prompt = false

[pull]
    rebase = true

[alias]
    l = log --oneline --graph --decorat
    la = log --oneline --graph --decorat --all
    master = checkout master
    develop = checkout develop
    dev = checkout dev
    co = checkout
    combine = "!combine() { git rebase -i HEAD~$1; }; combine"

[init]
	defaultBranch = master
